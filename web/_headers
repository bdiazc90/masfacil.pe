/*
  Content-Security-Policy: default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self'; worker-src 'self'; manifest-src 'self'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
