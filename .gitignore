# Artefactos preexistentes sin procedencia; se preservan, pero no son evidencia.
/fetch-gis.mjs
/gis-osinergmin.json

# Originales reutilizables: caché local explícita, nunca versionada.
/.local-cache/
/.agents/skills/archify/

# Artefactos de investigación y proyección: se regeneran localmente, nunca se publican en Git.
/data/

# Proyección pública generada desde el pointer local; nunca se versiona.
/web/data/

# Precache derivada del contenido y el script del service worker que lleva su
# versión; se generan al servir y al publicar.
/web/shell-manifest.js
/web/sw.js

# Interfaz compilada: `npm run build` la genera desde `ui/`; las fuentes son las
# de `ui/` y estas copias nunca se editan ni se versionan.
/web/index.html
/web/404.html
/web/assets/

# Dependencias instaladas; el lockfile sí se versiona, el árbol nunca.
/node_modules/

# Configuración local de desarrollo; nunca se lee ni se publica desde Git.
/.env
/.vscode/
