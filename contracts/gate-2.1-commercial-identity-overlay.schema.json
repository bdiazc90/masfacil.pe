{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:facilito-ux-lab:gate-2.1:commercial-identity-overlay:1.1.0",
  "title": "Overlay de identidad comercial separado de la entidad oficial",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "overlay_id", "official_dataset_id", "anchor_scheme", "entries"],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "overlay_id": { "type": "string", "pattern": "^commercial-identity-overlay-[a-z0-9.-]+$" },
    "official_dataset_id": { "type": "string", "pattern": "^gate-1\\.1-lima-province-gasohol-regular-[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "anchor_scheme": { "const": "gate-1.1-establishment-id-v1" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_anchor", "brand", "public_site_name", "source", "observed_at", "source_last_modified_at", "discovery_method", "integration_method", "identity_freshness", "verification_status", "publication_status"],
      "properties": {
        "official_anchor": { "type": "string", "pattern": "^est_[a-f0-9]{24}$" },
        "brand": { "type": "string", "minLength": 1 },
        "public_site_name": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "observed_at": { "type": "string", "format": "date-time" },
        "source_last_modified_at": { "type": ["string", "null"], "format": "date-time" },
        "discovery_method": { "const": "normalized_address_exact" },
        "integration_method": { "const": "official_anchor_exact" },
        "identity_freshness": { "enum": ["current", "stale", "unknown"] },
        "verification_status": { "enum": ["verified", "unverified", "conflict"] },
        "publication_status": { "enum": ["publishable", "not_publishable", "unknown"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": { "enum": ["first_party_web", "first_party_document", "owner_verified"] },
        "url": { "type": "string", "pattern": "^https://", "format": "uri" }
      }
    }
  }
}
