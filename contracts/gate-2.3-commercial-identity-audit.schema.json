{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:masfacil.pe:gate-2.3:commercial-identity-audit:1.0.0",
  "title": "Auditoría privada de vínculos comerciales",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "catalog_id", "entries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "audit_id": { "type": "string", "pattern": "^commercial-identity-audit-[a-z0-9.-]+$" },
    "catalog_id": { "type": "string", "pattern": "^commercial-identity-catalog-[a-z0-9.-]+$" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": { "entry": { "type": "object", "additionalProperties": false, "required": ["establishment_id", "entry_sha256", "selection_reason", "reviewer", "reviewed_at", "result"], "properties": {
    "establishment_id": { "type": "string", "pattern": "^est_[a-f0-9]{24}$" },
    "entry_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "selection_reason": { "enum": ["publishable_candidate", "random_sample", "risk_sample"] },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "result": { "enum": ["verified", "incorrect", "pending"] }
  } } }
}
