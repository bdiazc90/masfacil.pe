{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:masfacil-pe:gate-2.3:gasolina-product:v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision_id", "product", "scope", "snapshot_date", "cutoff_at", "source_max_reported_at", "provenance", "offers"],
  "allOf": [
    {"if": {"properties": {"product": {"properties": {"key": {"const": "regular"}}, "required": ["key"]}}}, "then": {"properties": {"product": {"properties": {"canonical": {"const": "GASOHOL REGULAR"}, "label": {"const": "Gasohol Regular"}}, "required": ["canonical", "label"]}}}},
    {"if": {"properties": {"product": {"properties": {"key": {"const": "premium"}}, "required": ["key"]}}}, "then": {"properties": {"product": {"properties": {"canonical": {"const": "GASOHOL PREMIUM"}, "label": {"const": "Gasohol Premium"}}, "required": ["canonical", "label"]}}}}
  ],
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "revision_id": {"type": "string", "minLength": 1},
    "product": {"type": "object", "additionalProperties": false, "required": ["key", "canonical", "label", "display_unit"], "properties": {"key": {"enum": ["regular", "premium"]}, "canonical": {"enum": ["GASOHOL REGULAR", "GASOHOL PREMIUM"]}, "label": {"enum": ["Gasohol Regular", "Gasohol Premium"]}, "display_unit": {"const": "Galones"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["department", "province"], "properties": {"department": {"const": "LIMA"}, "province": {"const": "LIMA"}}},
    "snapshot_date": {"type": "string", "format": "date"},
    "cutoff_at": {"type": "string", "format": "date-time"},
    "source_max_reported_at": {"type": "string", "format": "date-time"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source", "source_url", "attribution"], "properties": {"source": {"const": "Osinergmin"}, "source_url": {"type": "string", "format": "uri"}, "attribution": {"type": "string", "minLength": 1}}},
    "offers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "establishment_id", "commercial_identity", "price", "reported_at", "district", "longitude", "latitude"], "properties": {"id": {"type": "string", "pattern": "^g2_[a-f0-9]{24}$"}, "establishment_id": {"type": "string", "pattern": "^est_[a-f0-9]{24}$"}, "commercial_identity": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["brand", "public_site_name"], "properties": {"brand": {"type": ["string", "null"], "minLength": 1}, "public_site_name": {"type": ["string", "null"], "minLength": 1}}, "anyOf": [{"properties": {"brand": {"type": "string", "minLength": 1}}}, {"properties": {"public_site_name": {"type": "string", "minLength": 1}}}]}]}, "price": {"type": "number", "exclusiveMinimum": 0}, "reported_at": {"type": "string", "format": "date-time"}, "district": {"type": "string", "minLength": 1}, "longitude": {"type": "number", "minimum": -82, "maximum": -68}, "latitude": {"type": "number", "minimum": -19, "maximum": 1}}}}
  }
}
