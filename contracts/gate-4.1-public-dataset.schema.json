{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:facilito-ux-lab:gate-4.1:public-dataset:1.0.0",
  "title": "Dataset público estático de Gate 4.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "dataset_id", "product", "display_unit", "snapshot_date", "cutoff_at", "source_max_reported_at", "provenance", "offers"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "snapshot_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Za-z0-9-]+$" },
    "dataset_id": { "type": "string", "pattern": "^public-gasohol-regular-lima-[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "product": { "const": "Gasohol Regular" },
    "display_unit": { "const": "S/ por galón" },
    "snapshot_date": { "type": "string", "format": "date" },
    "cutoff_at": { "type": "string", "format": "date-time" },
    "source_max_reported_at": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "source_dataset", "source_url", "attribution"],
      "properties": {
        "source": { "const": "Osinergmin" },
        "source_dataset": { "const": "liquid-current" },
        "source_url": { "type": "string", "format": "uri" },
        "attribution": { "const": "Datos de precios y coordenadas: Osinergmin." }
      }
    },
    "offers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/offer" } }
  },
  "$defs": {
    "offer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "price", "reported_at", "district", "longitude", "latitude"],
      "properties": {
        "id": { "type": "string", "pattern": "^pub_[a-f0-9]{24}$" },
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "reported_at": { "type": "string", "format": "date-time" },
        "district": { "type": "string", "minLength": 1 },
        "longitude": { "type": "number", "minimum": -82, "maximum": -68 },
        "latitude": { "type": "number", "minimum": -19, "maximum": 1 }
      }
    }
  }
}
